# esb-service — plantilla. Copia a .env (ignorado por git) y NO subas valores reales.
# Misma llave interna que usan el Gateway y los siete microservicios.
INTERNAL_API_KEY=change-me
PORT=3100

# Direcciones gRPC de los siete servicios (local: 127.0.0.1; nube: host:443 con GRPC_TLS=true).
GRPC_TLS=false
INVENTORY_GRPC_URL=127.0.0.1:50051
PRICING_GRPC_URL=127.0.0.1:50052
ANCILLARIES_GRPC_URL=127.0.0.1:50053
RESERVATION_GRPC_URL=127.0.0.1:50054
TICKETING_GRPC_URL=127.0.0.1:50055
OPERATIONS_GRPC_URL=127.0.0.1:50056
WEBHOOKS_GRPC_URL=127.0.0.1:50057

# Plazos y tamaños (valores por defecto de PLAN §1.2; opcionales).
# ESB_DEFAULT_DEADLINE_MS=5000
# ESB_ORCHESTRATED_DEADLINE_MS=30000
# ESB_MAX_DEADLINE_MS=30000
# ESB_MAX_BODY_BYTES=1048576
