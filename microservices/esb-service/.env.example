# esb-service — plantilla. Copia a .env (ignorado por git) y NO subas valores reales.
# Misma llave interna que usan el Gateway y los siete microservicios.
INTERNAL_API_KEY=change-me
PORT=3100

# Direcciones gRPC de los siete servicios (local: 127.0.0.1; nube: host:443 con GRPC_TLS=true).
GRPC_TLS=false
INVENTORY_GRPC_URL=127.0.0.1:50051
PRICING_GRPC_URL=127.0.0.1:50052
ANCILLARIES_GRPC_URL=127.0.0.1:50053
RESERVATION_GRPC_URL=127.0.0.1:50054
TICKETING_GRPC_URL=127.0.0.1:50055
OPERATIONS_GRPC_URL=127.0.0.1:50056
WEBHOOKS_GRPC_URL=127.0.0.1:50057

# Bus de eventos (F12b-2, ADR-F12b-04/06). `outbox` guarda en el esquema esb y publica a RabbitMQ; `grpc` reenvía a Webhooks (vuelta atrás).
ESB_EVENTS_MODE=outbox
# Rol svc_esb (esquema esb). Local: pooler/host del Postgres local; nube: pooler de Supabase.
DATABASE_URL=postgresql://svc_esb:change-me@127.0.0.1:15432/flight_platform
DIRECT_URL=postgresql://svc_esb:change-me@127.0.0.1:15432/flight_platform
# Local: amqp://usuario:clave@127.0.0.1:5672/flight · Nube (CloudAMQP): amqps://... (obligatorio en producción)
RABBITMQ_URL=amqp://flight:change-me@127.0.0.1:5672/flight
# Opcionales (valores por defecto del diseño):
# RABBITMQ_CONNECT_TIMEOUT_MS=3000
# EVENTS_RETRY_TTLS_MS=30000,120000,600000
# EVENTS_PUBLISH_BATCH=100
# EVENTS_PUBLISH_MAX_BATCHES=5
# ESB_OUTBOX_LEASE_MS=60000
# ESB_OUTBOX_RETENTION_DAYS=7
# ESB_EVENT_MAX_BYTES=65536

# Plazos y tamaños (valores por defecto de PLAN §1.2; opcionales).
# ESB_DEFAULT_DEADLINE_MS=5000
# ESB_ORCHESTRATED_DEADLINE_MS=30000
# ESB_MAX_DEADLINE_MS=30000
# ESB_MAX_BODY_BYTES=1048576
