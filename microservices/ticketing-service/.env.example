# Supabase: pooler para la app y conexión directa para migraciones.
# Para Postgres local de Docker usa .env.docker.example.
DATABASE_URL=postgresql://svc_ticketing.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&schema=ticketing
DIRECT_URL=postgresql://svc_ticketing.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:5432/postgres?schema=ticketing
INTERNAL_API_KEY=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
LOG_LEVEL=info
GRPC_TLS=false
PORT=50055
ETICKET_PREFIX=999
TICKETING_FAIL_MODE=none
