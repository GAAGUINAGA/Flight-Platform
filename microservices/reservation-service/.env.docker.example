# Docker local: base flight_platform en 127.0.0.1:15432; sin pooler.
DATABASE_URL=postgresql://svc_reservation:REPLACE_WITH_LOCAL_ROLE_PASSWORD@127.0.0.1:15432/flight_platform?schema=reservation
DIRECT_URL=postgresql://svc_reservation:REPLACE_WITH_LOCAL_ROLE_PASSWORD@127.0.0.1:15432/flight_platform?schema=reservation
INTERNAL_API_KEY=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
LOG_LEVEL=info
GRPC_TLS=false
PORT=50054
INVENTORY_GRPC_URL=localhost:50051
PRICING_GRPC_URL=localhost:50052
ANCILLARIES_GRPC_URL=localhost:50053
TICKETING_GRPC_URL=localhost:50055
WEBHOOKS_GRPC_URL=localhost:50057
CANCEL_QUOTE_TTL_MINUTES=15
TICKETING_MAX_ATTEMPTS=3
BAGGAGE_CUTOFF_HOURS=4
PAYMENT_MODE=fake
