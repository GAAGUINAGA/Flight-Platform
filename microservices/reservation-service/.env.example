# Supabase: pooler para la app y conexión directa para migraciones.
# Para Postgres local de Docker usa .env.docker.example.
DATABASE_URL=postgresql://svc_reservation.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&schema=reservation
DIRECT_URL=postgresql://svc_reservation.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:5432/postgres?schema=reservation
INTERNAL_API_KEY=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
LOG_LEVEL=info
GRPC_TLS=false
PORT=50054
INVENTORY_GRPC_URL=localhost:50051
PRICING_GRPC_URL=localhost:50052
ANCILLARIES_GRPC_URL=localhost:50053
TICKETING_GRPC_URL=localhost:50055
WEBHOOKS_GRPC_URL=localhost:50057
CANCEL_QUOTE_TTL_MINUTES=15
TICKETING_MAX_ATTEMPTS=3
BAGGAGE_CUTOFF_HOURS=4
PAYMENT_MODE=fake
