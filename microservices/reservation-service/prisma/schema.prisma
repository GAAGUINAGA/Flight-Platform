
generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/persistence/prisma-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Reservation {
  id              String   @id @default(uuid()) @db.Uuid
  ownerId         String   @map("owner_id") @db.VarChar(128)
  pnr             String   @unique @db.VarChar(6)
  status          String   @db.VarChar(32)
  holdId          String   @map("hold_id") @db.Uuid
  itineraries     Json     @default("[]")
  grandTotal      Json     @map("grand_total")
  paymentReference String? @map("payment_reference") @db.VarChar(255)
  idempotencyKey  String   @map("idempotency_key") @db.VarChar(255)
  sagaStep        String   @map("saga_step") @db.VarChar(64)
  pendingOperation Json?   @map("pending_operation")
  attempts        Int      @default(0)
  paymentChannel  String?  @map("payment_channel") @db.VarChar(16)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  passengers      ReservationPassenger[]
  changes         ReservationChange[]
  paymentUsages   PaymentUsage[]
  baggagePurchases BaggagePurchase[]
  cancellationQuotes CancellationQuoteRecord[]
  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
  @@map("reservations")
}

model ReservationPassenger {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  passengerId   String   @map("passenger_id") @db.Uuid
  data          Json
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  @@unique([reservationId, passengerId])
  @@map("reservation_passengers")
}

model ReservationChange {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  changedAt     DateTime @map("changed_at") @db.Timestamptz(3)
  description   String   @db.VarChar(255)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  @@index([reservationId, changedAt])
  @@map("reservation_changes")
}

model PaymentUsage {
  paymentReference String @id @map("payment_reference") @db.VarChar(255)
  reservationId    String @map("reservation_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reservation      Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  @@map("payment_usages")
}

model BaggagePurchase {
  id               String @id @db.Uuid
  bookingId        String @map("booking_id") @db.Uuid
  ownerId          String @map("owner_id") @db.VarChar(128)
  idempotencyKey   String @map("idempotency_key") @db.VarChar(255)
  requestHash      String @map("request_hash") @db.VarChar(64)
  paymentReference String @unique @map("payment_reference") @db.VarChar(255)
  amountMinor      Int @map("amount_minor")
  status           String @db.VarChar(16)
  response         Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  reservation      Reservation @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@unique([ownerId, idempotencyKey])
  @@index([bookingId, ownerId])
  @@map("baggage_purchases")
}

model CancellationQuoteRecord {
  quoteId       String   @id @map("quote_id") @db.VarChar(128)
  bookingId     String   @map("booking_id") @db.Uuid
  ownerId       String   @map("owner_id") @db.VarChar(128)
  payload       Json
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reservation   Reservation @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, ownerId, expiresAt])
  @@map("cancellation_quotes")
}
