# Supabase: pooler para la app y conexión directa para migraciones.
# Para Postgres local de Docker usa .env.docker.example.
DATABASE_URL=postgresql://svc_operations.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&schema=operations
DIRECT_URL=postgresql://svc_operations.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:5432/postgres?schema=operations
INTERNAL_API_KEY=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
LOG_LEVEL=info
GRPC_TLS=false
PORT=50056
INVENTORY_GRPC_URL=localhost:50051
RESERVATION_GRPC_URL=localhost:50054
TICKETING_GRPC_URL=localhost:50055
ANCILLARIES_GRPC_URL=localhost:50053
WEBHOOKS_GRPC_URL=localhost:50057
CHECKIN_OPEN_HOURS=48
CHECKIN_CLOSE_MINUTES=60
DELAY_THRESHOLD_MINUTES=15
