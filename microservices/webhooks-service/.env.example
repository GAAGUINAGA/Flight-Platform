# Supabase: pooler para la app y conexión directa para migraciones.
# Para Postgres local de Docker usa .env.docker.example.
DATABASE_URL=postgresql://svc_webhooks.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&schema=webhooks
DIRECT_URL=postgresql://svc_webhooks.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:5432/postgres?schema=webhooks
INTERNAL_API_KEY=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
LOG_LEVEL=info
GRPC_TLS=false
PORT=50057
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_BACKOFF_MINUTES=1,5,15,60,180,720
ALLOW_INSECURE_WEBHOOK_URLS=false
