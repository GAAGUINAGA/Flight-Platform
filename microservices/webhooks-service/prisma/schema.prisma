generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/persistence/prisma-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Subscription {
  id              String     @id @db.Uuid
  ownerId         String     @map("owner_id") @db.VarChar(128)
  url             String     @db.VarChar(2048)
  events          String[]
  encryptedSecret String     @map("encrypted_secret")
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveries      Delivery[]
  @@index([ownerId, active])
  @@map("subscriptions")
}

model Delivery {
  id             String       @id @default(uuid()) @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  payload        Json
  status         String       @db.VarChar(16)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @map("next_attempt_at") @db.Timestamptz(3)
  lastAttemptAt  DateTime?    @map("last_attempt_at") @db.Timestamptz(3)
  deliveredAt    DateTime?    @map("delivered_at") @db.Timestamptz(3)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@unique([eventId, subscriptionId])
  @@index([status, nextAttemptAt])
  @@map("deliveries")
}
