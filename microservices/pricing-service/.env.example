# Supabase: pooler para la app y conexión directa para migraciones.
# Para Postgres local de Docker usa .env.docker.example.
DATABASE_URL=postgresql://svc_pricing.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&schema=pricing
DIRECT_URL=postgresql://svc_pricing.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:5432/postgres?schema=pricing
INTERNAL_API_KEY=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
LOG_LEVEL=info
GRPC_TLS=false
PORT=50052
INVENTORY_GRPC_URL=localhost:50051
OFFER_TTL_MINUTES=15
CHANGE_OFFER_TTL_MINUTES=15
MIN_CONNECTION_MINUTES=60
MAX_STOPS=1
CHANGE_FEE_MINOR=5000
CANCEL_PENALTY_MINOR=0
CURRENCY=USD
AIRLINE_CODE=FP
AIRLINE_NAME=REPLACE_WITH_AIRLINE_NAME
