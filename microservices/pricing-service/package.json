{
  "name": "@flight-platform/pricing-service",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/copy-prisma-client.cjs",
    "start": "node dist/main.js",
    "test": "cd ../.. && npx jest microservices/pricing-service --runInBand",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@flight-platform/shared": "0.1.0",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@prisma/client": "6.12.0",
    "dotenv": "^16.6.1",
    "grpc-health-check": "^2.1.0",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "prisma": "6.12.0",
    "yaml": "^2.8.1"
  }
}
