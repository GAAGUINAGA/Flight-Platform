# Supabase Postgres: use the dedicated svc_ancillaries role and ancillaries schema.
# For local Docker Postgres use .env.docker.example.
# Pooler connection (port 6543) for normal application queries.
DATABASE_URL=postgresql://svc_ancillaries.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&schema=ancillaries
# Direct connection (port 5432) for Prisma migrations.
DIRECT_URL=postgresql://svc_ancillaries.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:5432/postgres?schema=ancillaries

# Shared private key used to authenticate inbound and outbound gRPC calls.
# Generate at least 32 random bytes; do not commit the real value.
INTERNAL_API_KEY=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
LOG_LEVEL=info
GRPC_TLS=false
PORT=50053

# Dependency endpoints. Use host:port locally and the Cloud Run hostname:443 in production.
INVENTORY_GRPC_URL=localhost:50051
PRICING_GRPC_URL=localhost:50052
