# Supabase: pooler para la app y conexión directa para migraciones.
# Para Postgres local de Docker usa .env.docker.example.
DATABASE_URL=postgresql://svc_inventory.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&schema=inventory
DIRECT_URL=postgresql://svc_inventory.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:5432/postgres?schema=inventory
INTERNAL_API_KEY=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
LOG_LEVEL=info
GRPC_TLS=false
PORT=50051
HOLD_TTL_MINUTES=20
WEBHOOKS_GRPC_URL=localhost:50057
