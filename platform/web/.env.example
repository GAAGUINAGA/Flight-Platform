# Variables PÚBLICAS de la web (se incrustan en el bundle: aquí nunca va un secreto). Copiar a .env.local para `npm run dev -w @flight-platform/web`.
# Con `npm run local:up -- -Web` no hace falta ningún archivo: el script las fija para la plataforma local.

# URL completa del servicio GraphQL (termina en /graphql). La web SOLO habla con este servicio y con Supabase Auth.
VITE_GRAPHQL_URL=
# URL del proyecto de Supabase (sin /auth/v1).
VITE_SUPABASE_URL=
# Llave anon de Supabase (pública por diseño). NUNCA la llave service_role.
VITE_SUPABASE_ANON_KEY=
# produccion | pruebas | local. Distinto de `produccion` muestra la banda «Entorno de pruebas».
VITE_ENV_NAME=local
# Opcionales: umbrales del estado de carga (ms) y tiempo máximo por operación.
# VITE_LOADING_SLOW_MS=1500
# VITE_LOADING_VERY_SLOW_MS=8000
# VITE_REQUEST_TIMEOUT_MS=25000
