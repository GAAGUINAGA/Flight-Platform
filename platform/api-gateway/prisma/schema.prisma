generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output = "../generated/prisma-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["gateway"]
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  ownerId      String   @map("owner_id")
  key          String
  requestHash  String   @map("request_hash")
  status       String
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@unique([ownerId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("gateway")
}

model DevAuthClient {
  clientId   String   @id @map("client_id")
  secretHash String   @map("secret_hash")
  scopes     String[]
  active     Boolean  @default(true)
  name       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("dev_auth_client")
  @@schema("gateway")
}

model V2Booking {
  bookingId        String   @id @map("booking_id") @db.Uuid
  clientId         String   @map("client_id")
  ownerId          String   @map("owner_id")
  holdId           String   @map("hold_id") @db.Uuid
  paymentReference String   @map("payment_reference")
  salesChannel     Json?    @map("sales_channel")
  passengerMap     Json     @default("{}") @map("passenger_map")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@index([paymentReference])
  @@index([holdId])
  @@map("v2_booking")
  @@schema("gateway")
}

model V2ProcessedEvent {
  clientId    String   @map("client_id")
  eventId     String   @map("event_id")
  eventType   String   @map("event_type")
  outcome     String
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([clientId, eventId])
  @@map("v2_processed_event")
  @@schema("gateway")
}

model SchedulerLock {
  task        String   @id
  lockedUntil DateTime @map("locked_until")

  @@map("scheduler_locks")
  @@schema("gateway")
}
