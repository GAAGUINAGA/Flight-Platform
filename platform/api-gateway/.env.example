# API Gateway — plantilla de entorno local (PLAN §8). Copia a .env y reemplaza
# solo los valores REPLACE_WITH_...; el resto ya sirve para desarrollo local.

PORT=3000
LOG_LEVEL=info
# false en local; true solo hacia servicios en Cloud Run.
GRPC_TLS=false

# Secreto compartido con los servicios internos (x-internal-key).
# Debe ser IDÉNTICO al INTERNAL_API_KEY de los siete microservicios.
# Obtenerlo: copia el valor de microservices/<servicio>/.env, o genera uno con
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET

# Postgres local de Docker (127.0.0.1:15432), rol svc_gateway, schema gateway.
# La contraseña la define el rol en infra/db/roles.sql / la base local;
# pídela a quien administra la base. Mismo valor en DATABASE_URL y DIRECT_URL.
DATABASE_URL=postgresql://svc_gateway:REPLACE_WITH_LOCAL_ROLE_PASSWORD@127.0.0.1:15432/flight_platform?schema=gateway
DIRECT_URL=postgresql://svc_gateway:REPLACE_WITH_LOCAL_ROLE_PASSWORD@127.0.0.1:15432/flight_platform?schema=gateway

# Emisores JWT aceptados (JSON en una sola línea). Por emisor: iss, aud, role
# (rol por defecto) y UNA de: jwksUri | publicKeyFile.
# publicKeyFile solo se permite con NODE_ENV != production; en producción el
# Gateway rechaza arrancar si algún emisor lo usa (usa jwksUri).
# Local: genera el par con `npm run dev:token -- --init-keys` (ver AGENTS.md);
# la pública queda en infra/dev-keys/dev-public.pem (ruta relativa a la raíz del repo).
JWT_ISSUERS=[{"iss":"flight-platform-dev","aud":"flight-platform","role":"customer","publicKeyFile":"infra/dev-keys/dev-public.pem"}]

# Orígenes CORS permitidos, separados por coma (frontend Vite local).
CORS_ORIGINS=http://localhost:5173

# Límites por minuto (por fingerprint o sub).
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=120

IDEMPOTENCY_TTL_HOURS=24
# true en desarrollo y pruebas; false en producción.
VALIDATE_RESPONSES=true
# Tareas programadas (mantenimiento); apagadas por defecto en local.
SCHEDULER_ENABLED=false

# Destinos gRPC de los servicios. Opcionales: sin definir se usan los puertos
# locales por defecto (localhost:5005x). Descomenta solo para apuntar a otro
# host (en Cloud Run: <hostname>:443 con GRPC_TLS=true; URL en la consola de
# Cloud Run o en `gcloud run services describe <servicio> --format="value(status.url)"`).
# INVENTORY_GRPC_URL=localhost:50051
# PRICING_GRPC_URL=localhost:50052
# ANCILLARIES_GRPC_URL=localhost:50053
# RESERVATION_GRPC_URL=localhost:50054
# TICKETING_GRPC_URL=localhost:50055
# OPERATIONS_GRPC_URL=localhost:50056
# WEBHOOKS_GRPC_URL=localhost:50057
