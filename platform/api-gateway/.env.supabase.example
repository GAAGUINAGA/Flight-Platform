# API Gateway — plantilla para Supabase + servicios en Cloud Run (PLAN §8).
# Copia a .env.supabase y reemplaza los valores REPLACE_WITH_... No lo subas a git.
# Para Postgres local de Docker usa .env.example.

NODE_ENV=production
# Render inyecta PORT; este valor solo aplica si lo ejecutas fuera de Render.
PORT=3000
LOG_LEVEL=info

# Cloud Run exige TLS.
GRPC_TLS=true

# Secreto compartido con los siete microservicios (x-internal-key).
# Debe ser IDÉNTICO a su INTERNAL_API_KEY. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET

# Supabase: pooler (6543) para la app y conexión directa (5432) para migraciones.
# Rol svc_gateway, schema gateway.
DATABASE_URL=postgresql://svc_gateway.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&schema=gateway
DIRECT_URL=postgresql://svc_gateway.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_PASSWORD@REPLACE_WITH_SUPABASE_POOLER_HOST:5432/postgres?schema=gateway

# Emisores JWT (JSON en una sola línea). En producción solo jwksUri: el Gateway
# no arranca con publicKeyFile ni con el emisor flight-platform-dev.
JWT_ISSUERS=[{"iss":"REPLACE_WITH_ISSUER","aud":"REPLACE_WITH_AUDIENCE","role":"customer","jwksUri":"REPLACE_WITH_JWKS_URL"}]

# Orígenes CORS permitidos, separados por coma (URL del frontend desplegado).
CORS_ORIGINS=REPLACE_WITH_FRONTEND_ORIGIN

RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=120
IDEMPOTENCY_TTL_HOURS=24
VALIDATE_RESPONSES=false
SCHEDULER_ENABLED=false

# Destinos gRPC en Cloud Run: <hostname>:443 (sin https://).
# URL: `gcloud run services describe <servicio> --format="value(status.url)"`.
INVENTORY_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
PRICING_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
ANCILLARIES_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
RESERVATION_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
TICKETING_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
OPERATIONS_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
WEBHOOKS_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443

# --- F12a: contrato v2 y dev-auth (OAuth2 client_credentials) ---
# URL pública del Gateway en Render, sin ruta ni barra final (https obligatorio). Es el emisor de los tokens del dev-auth.
PUBLIC_BASE_URL=REPLACE_WITH_RENDER_PUBLIC_URL
# Llave privada RSA (PEM pkcs8) de firma del dev-auth. SECRETA: variable de entorno de Render (con \n escapados) o
# Secret Manager inyectado como variable. En producción NO se admite DEV_AUTH_PRIVATE_KEY_FILE y el Gateway no arranca sin llave.
DEV_AUTH_PRIVATE_KEY=REPLACE_WITH_PEM_PRIVATE_KEY
# Nodo ante Booking (solo cambia si el nombre del nodo cambia).
NODE_ID=NODE_VUE_GABATAIR

# --- Booking (todo opcional: vacío = apagado; la plataforma funciona sin Booking) ---
# Stock gRPC: se activa solo con URL y clave; en producción el TLS es obligatorio.
BOOKING_STOCK_GRPC_URL=
BOOKING_STOCK_API_KEY=
# booking-events: con secreto vacío rechaza todo. Si hay secreto, BOOKING_EVENTS_CLIENT_ID (client_id de Booking en el dev-auth) es obligatorio.
BOOKING_EVENTS_SECRET=
BOOKING_EVENTS_CLIENT_ID=
