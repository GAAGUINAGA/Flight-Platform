# API Gateway — plantilla para Supabase + servicios en Cloud Run (PLAN §8).
# Copia a .env.supabase y reemplaza los valores REPLACE_WITH_... No lo subas a git.
# Para Postgres local de Docker usa .env.example.

NODE_ENV=production
# Render inyecta PORT; este valor solo aplica si lo ejecutas fuera de Render.
PORT=3000
LOG_LEVEL=info

# Cloud Run exige TLS.
GRPC_TLS=true

# Secreto compartido con los siete microservicios (x-internal-key).
# Debe ser IDÉNTICO a su INTERNAL_API_KEY. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET

# Supabase: pooler (6543) para la app y conexión directa (5432) para migraciones.
# Rol svc_gateway, schema gateway.
DATABASE_URL=postgresql://svc_gateway.cjqcrdmcznqzmnahxmvd:fdb40bafaf759ba905badc24ba9daf39f9ba5d90e5f4fcf8@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&schema=gateway
DIRECT_URL=postgresql://svc_gateway.cjqcrdmcznqzmnahxmvd:fdb40bafaf759ba905badc24ba9daf39f9ba5d90e5f4fcf8@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=gateway

# Emisores JWT (JSON en una sola línea). En producción solo jwksUri: el Gateway
# no arranca con publicKeyFile ni con el emisor flight-platform-dev.
JWT_ISSUERS=[{"iss":"REPLACE_WITH_ISSUER","aud":"REPLACE_WITH_AUDIENCE","role":"customer","jwksUri":"REPLACE_WITH_JWKS_URL"}]

# Orígenes CORS permitidos, separados por coma (URL del frontend desplegado).
CORS_ORIGINS=REPLACE_WITH_FRONTEND_ORIGIN

RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=120
IDEMPOTENCY_TTL_HOURS=24
VALIDATE_RESPONSES=false
SCHEDULER_ENABLED=false

# Destinos gRPC en Cloud Run: <hostname>:443 (sin https://).
# URL: `gcloud run services describe <servicio> --format="value(status.url)"`.
INVENTORY_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
PRICING_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
ANCILLARIES_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
RESERVATION_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
TICKETING_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
OPERATIONS_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
WEBHOOKS_GRPC_URL=REPLACE_WITH_CLOUD_RUN_HOST:443
