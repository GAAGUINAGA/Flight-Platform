{
  "info": {
    "name": "Flight Platform — GDS Flight Core API v1.5.0.0",
    "description": "22 operaciones REST del contrato (OP-01 a OP-22), el callback OP-23 y las rutas admin. Sin secretos: define accessToken en tu entorno local y no lo guardes en el archivo. Orden recomendado: carpeta por carpeta, de arriba abajo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Búsqueda y catálogo (públicas)",
      "item": [
        {
          "name": "OP-01 POST /search — Búsqueda",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const offer = pm.response.json().offers[0]; const itinerary = offer.itineraries[0]; const option = itinerary.pricingOptions[0];",
                  "pm.collectionVariables.set('offerId', offer.offerId); pm.collectionVariables.set('itineraryId', itinerary.itineraryId); pm.collectionVariables.set('segmentId', itinerary.segments[0].segmentId);",
                  "pm.collectionVariables.set('cabinClass', option.cabinClass); pm.collectionVariables.set('fareBrand', option.fareBrand);",
                  "pm.collectionVariables.set('flightNumber', itinerary.segments[0].flightNumber);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-Fingerprint",
                "value": "{{deviceFingerprint}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itineraries\": [\n    {\n      \"origin\": \"{{origin}}\",\n      \"destination\": \"{{destination}}\",\n      \"departureDate\": \"{{departureDate}}\"\n    }\n  ],\n  \"passengers\": {\n    \"adults\": 1\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/flights/v1/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights",
                "v1",
                "search"
              ]
            }
          }
        },
        {
          "name": "OP-02 GET /offers/{{offerId}}/seatmap — Mapa de asientos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Device-Fingerprint",
                "value": "{{deviceFingerprint}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/flights/v1/offers/{{offerId}}/seatmap?segmentId={{segmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights",
                "v1",
                "offers",
                "{{offerId}}",
                "seatmap"
              ],
              "query": [
                {
                  "key": "segmentId",
                  "value": "{{segmentId}}"
                }
              ]
            }
          }
        },
        {
          "name": "OP-22 GET /flights/{{flightNumber}}/status — Estado de vuelo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Device-Fingerprint",
                "value": "{{deviceFingerprint}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/flights/v1/flights/{{flightNumber}}/status?date={{departureDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights",
                "v1",
                "flights",
                "{{flightNumber}}",
