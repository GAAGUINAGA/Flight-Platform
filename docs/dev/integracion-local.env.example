# Perfil de integración local (reunión con Booking por Tailscale, http/gRPC sin TLS, servidor a servidor).
# Copia a .local/integracion.env (ignorado por git) y rellena los REEMPLAZAR. Nunca subas ese archivo ni lo pegues en chats.
# scripts/local-platform/up.ps1 lo lee y entrega a cada proceso solo las variables que le corresponden. Sin comillas ni espacios alrededor de "=".
# Cambiar un valor exige reiniciar (down.ps1 y up.ps1 -SkipBuild).

# ---------- Gateway ----------
# URL con la que Booking llega a la aerolínea: IP Tailscale de ESTA máquina y puerto del Gateway (sin barra final ni ruta).
# Es el emisor de los tokens del dev-auth y la base de los _links.
PUBLIC_BASE_URL=http://100.x.x.x:3000
# Identidad del nodo en health y CloudEvents.
NODE_ID=NODE_VUE_GABATAIR
PROVIDER_NAME=GabatAIR
# Secreto compartido con Booking para firmar POST /api/v2/vuelos/booking-events (HMAC-SHA256 del cuerpo). Sin él, el endpoint rechaza todo.
BOOKING_EVENTS_SECRET=REEMPLAZAR_SECRETO_COMPARTIDO
# BOOKING_EVENTS_SIGNATURE_HEADER=X-Webhook-Signature
# BOOKING_EVENTS_SIGNATURE_PREFIX=sha256=
# Ventana (minutos desde la creación de la reserva) sin penalidad para SAGA_COMPENSATION.
# SAGA_PENALTY_WAIVER_MINUTES=120
# Aeropuertos fuera de Ecuador para la hora local del stock (JSON IATA -> zona).
# AIRPORT_TIMEZONES={"BOG":"America/Bogota"}

# ---------- Stock hacia Booking (gRPC PushStockUpdate) ----------
# Sin BOOKING_STOCK_API_KEY el envío queda apagado (se registra un aviso y las operaciones no se afectan).
# BOOKING_STOCK_GRPC_URL=100.x.x.x:50051
# BOOKING_STOCK_API_KEY=REEMPLAZAR_X_API_KEY_DE_BOOKING
BOOKING_STOCK_TLS=false

# ---------- API de pagos de Booking (reservation-service) ----------
# BOOKING_PAYMENTS_BASE_URL=http://100.x.x.x:8080
# BOOKING_PAYMENTS_PATH_TEMPLATE=/pagos/{paymentReference}
# BOOKING_PAYMENTS_AUTH_HEADER=Authorization
# BOOKING_PAYMENTS_AUTH_VALUE=REEMPLAZAR_CREDENCIAL_DE_BOOKING
# BOOKING_PAYMENTS_STATUS_MAP={"CONFIRMED":["CONFIRMADO"],"PENDING":["PENDIENTE"],"FAILED":["FALLIDO"]}
# BOOKING_PAYMENTS_FIELDS={"status":["estado"],"amount":["monto"],"currency":["moneda"]}
# ⚠ SOLO si la API de pagos de Booking NO está disponible: autoriza todo pago SIN verificarlo (ni existencia, ni estado, ni monto).
# Requiere INTEGRATION_LOCAL=true (lo fija up.ps1); el servicio no arranca así en producción. Quitar la línea en cuanto Booking responda.
# BOOKING_PAYMENTS_VERIFY=off

# ---------- Webhooks de la aerolínea hacia Booking (webhooks-service) ----------
# WEBHOOK_BACKOFF_MINUTES_V2=1,5,30,120,360
