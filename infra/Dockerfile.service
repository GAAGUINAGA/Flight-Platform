FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
COPY microservices ./microservices
COPY platform ./platform
COPY tsconfig.base.json ./
RUN npm ci
ARG SERVICE
RUN npm run build --workspace=@flight-platform/shared
RUN npm run build --workspace=${SERVICE}

FROM node:20-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN groupadd --system flight && useradd --system --gid flight flight
COPY --from=build --chown=flight:flight /app /app
USER flight
ARG SERVICE
ENV SERVICE=${SERVICE}
CMD ["sh", "-c", "node ${SERVICE}/dist/main.js"]
