{
  "name": "flight-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20 <21"
  },
  "workspaces": [
    "packages/*",
    "microservices/*",
    "platform/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings=0 && node scripts/verify-workspace-dist.cjs",
    "test": "jest --passWithNoTests",
    "gen:contracts": "npm run gen --workspace=@flight-platform/contracts",
    "dev:token": "tsx infra/scripts/dev-token.ts",
    "dev-auth:client": "tsx platform/api-gateway/scripts/dev-auth-client.ts",
    "local:up": "powershell -NoProfile -File scripts/local-platform/up.ps1",
    "local:down": "powershell -NoProfile -File scripts/local-platform/down.ps1",
    "local:seed": "powershell -NoProfile -File scripts/local-platform/seed.ps1",
    "local:health": "node scripts/local-platform/health.cjs",
    "local:journey": "node scripts/local-platform/journey.cjs",
    "audit:policy": "node scripts/audit-policy.cjs",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  }
}
